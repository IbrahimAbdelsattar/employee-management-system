    PROFILES {
        int id PK
        string uid
        string email
        string full_name
        string account_status
    }
    USER_ROLES {
        int id PK
        int profile_id FK
        string role
    }
    DEPARTMENTS {
        int id PK
        string code
        string name
        int manager_employee_id
        float budget_egp
        boolean is_archived
    }
    JOB_TITLES {
        int id PK
        string code
        string title
        int department_id FK
        float min_salary_egp
        float max_salary_egp
    }
    EMPLOYEES {
        int id PK
        string employee_number
        int profile_id FK
        string first_name
        string last_name
        string email
        int department_id FK
        int job_title_id FK
        int manager_id FK
        string employment_status
        string hire_date
    }
    ATTENDANCE_RECORDS {
        int id PK
        int employee_id FK
        string attendance_date
        int worked_minutes
        int late_minutes
        string status
    }
    LEAVE_TYPES {
        int id PK
        string code
        string name
        int default_days_per_year
        boolean is_paid
    }
    LEAVE_ENTITLEMENTS {
        int id PK
        int employee_id FK
        int leave_type_id FK
        int year
        float allocated_days
        float used_days
        float pending_days
    }
    LEAVE_REQUESTS {
        int id PK
        int employee_id FK
        int leave_type_id FK
        string start_date
        string end_date
        float total_days
        string status
    }
    TASKS {
        int id PK
        string title
        int assignee_employee_id FK
        int department_id FK
        string priority
        string status
        int progress_percent
    }
    PERFORMANCE_REVIEWS {
        int id PK
        int employee_id FK
        int reviewer_employee_id FK
        string review_cycle
        float overall_rating
        string status
    }
    ONBOARDING_CHECKLISTS {
        int id PK
        int employee_id FK
        string checklist_type
        string status
    }
    COMPENSATION_RECORDS {
        int id PK
        int employee_id FK
        float base_salary_egp
        float housing_allowance_egp
        boolean is_current
    }
    PAYROLL_PERIODS {
        int id PK
        string period_code
        string status
        float total_gross_egp
        float total_net_egp
    }
    PAYROLL_ITEMS {
        int id PK
        int payroll_period_id FK
        int employee_id FK
        float gross_pay_egp
        float net_pay_egp
        string payment_status
    }
